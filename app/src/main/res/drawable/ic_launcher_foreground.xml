<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: a raised keycap with a half-closed eye on its face,
  "a key that keeps an eye shut". Drawn inside the 66dp safe zone of the 108dp adaptive canvas,
  so every launcher mask shape keeps it whole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- keycap shadow lip -->
    <path
        android:fillColor="#1B4D37"
        android:pathData="M37,35h34a7,7 0,0 1,7 7v28a7,7 0,0 1,-7 7h-34a7,7 0,0 1,-7 -7v-28a7,7 0,0 1,7 -7z" />
    <!-- keycap face -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,31h34a7,7 0,0 1,7 7v26a7,7 0,0 1,-7 7h-34a7,7 0,0 1,-7 -7v-26a7,7 0,0 1,7 -7z" />
    <!-- eye outline -->
    <path
        android:fillColor="#2E7D5B"
        android:pathData="M38,51c8,-10 24,-10 32,0c-8,10 -24,10 -32,0z" />
    <!-- iris -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,51m-5.5,0a5.5,5.5 0,1 1,11 0a5.5,5.5 0,1 1,-11 0" />
    <!-- lowered eyelid: the top half of the eye is closed -->
    <path
        android:fillColor="#2E7D5B"
        android:pathData="M38,51c8,-10 24,-10 32,0z" />
    <!-- lash line -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M39,51h30" />
</vector>
